# macOS-only generic tools. Cross-platform generic tools live in
# generic/Brewfile.crossplatform and are installed alongside this file.
# User-level generic setup lives in generic/install.zsh.

brew "direnv"
brew "fdupes"
brew "ghostscript"
brew "ipcalc"
brew "mas"
brew "oath-toolkit"
brew "ripsecrets"
brew "trash"
brew "tree"
brew "watch"
brew "xcodes"
# The package zsh-completions lists the following caveats. I never had to bother with it but you may have to:
# You may also need to force rebuild zcompdump:
#   rm -f ~/.zcompdump; compinit
# Additionally, if you receive "zsh compinit: insecure directories" warnings when attempting
# to load these completions, you may need to run these commands:
#   chmod go-w '/opt/homebrew/share'
#   chmod -R go-w '/opt/homebrew/share/zsh'
brew "zsh-completions"
